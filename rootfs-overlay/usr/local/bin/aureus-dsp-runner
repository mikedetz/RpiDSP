#!/usr/bin/env python3

import os
import re
import signal
import subprocess
import time
from pathlib import Path

CAMILLADSP = "/usr/local/bin/camilladsp"
CONFIG_DIR = Path("/usr/local/share/aureus/configs")

RATES = [
    44100,
    48000,
    88200,
    96000,
    176400,
    192000,
    352800,
    384000,
    705600,
    768000,
]

current_rate = None
process = None


def detect_rate():

    paths = Path("/proc/asound").glob(
        "card*/pcm*c/sub*/hw_params"
    )

    for path in paths:

        try:
            data = path.read_text()
        except Exception:
            continue

        match = re.search(
            r"rate:\s*(\d+)",
            data
        )

        if not match:
            continue

        rate = int(match.group(1))

        if rate in RATES:
            return rate

    return None


def stop_camilla():

    global process

    if process is None:
        return

    if process.poll() is None:

        try:
            process.send_signal(signal.SIGTERM)
            process.wait(timeout=3)

        except subprocess.TimeoutExpired:

            process.kill()

    process = None


def start_camilla(rate):

    global process

    config = CONFIG_DIR / f"pcm-{rate}.yml"

    if not config.exists():

        print(
            f"No CamillaDSP config for {rate} Hz",
            flush=True
        )

        return

    print(
        f"Starting CamillaDSP at {rate} Hz",
        flush=True
    )

    process = subprocess.Popen(
        [
            CAMILLADSP,
            str(config)
        ],
        stdout=subprocess.STDOUT,
        stderr=subprocess.STDOUT
    )


def main():

    global current_rate

    print(
        "AUREUS DSP runner started",
        flush=True
    )

    while True:

        rate = detect_rate()

        if rate != current_rate:

            stop_camilla()

            current_rate = rate

            if rate is not None:

                start_camilla(rate)

        time.sleep(0.25)


if __name__ == "__main__":
    main()
