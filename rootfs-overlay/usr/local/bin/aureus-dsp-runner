#!/usr/bin/env python3
import os, re, subprocess, time, signal, sys
from pathlib import Path

STATE = Path("/run/aureus")
STATE.mkdir(parents=True, exist_ok=True)
STATUS = STATE / "status"
CONF = STATE / "camilla.yml"
LOG = Path("/var/log/aureus/camilladsp.log")
RATES = [44100,48000,88200,96000,176400,192000,352800,384000,705600,768000]

def cards(cmd):
    p = subprocess.run(cmd, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return p.stdout

def find_capture():
    out = cards(["arecord","-l"])
    m = re.search(r"card\s+(\d+):\s*([^\s\[]+)", out)
    if not m: return None
    return m.group(2)

def find_playback():
    out = cards(["aplay","-l"])
    # Prefer XMOS / EVO / USB devices.
    for pat in [r"card\s+\d+:\s*([^\s\[]*(?:EVO|XMOS|USB)[^\s\[]*)", r"card\s+(\d+):\s*([^\s\[]+)"]:
        m = re.search(pat, out, re.I)
        if m: return m.group(1)
    return None

def active_rate(card):
    # ALSA hw_params is populated while Windows has opened the gadget stream.
    base = Path("/proc/asound")
    for p in base.glob("card*/pcm*c/sub*/hw_params"):
        try:
            txt = p.read_text()
        except Exception:
            continue
        if "closed" in txt:
            continue
        m = re.search(r"rate:\s*(\d+)", txt)
        if m and int(m.group(1)) in RATES:
            # Prefer the card containing the gadget name.
            parent = str(p)
            if card.lower() in parent.lower() or "card" in parent:
                return int(m.group(1))
    return None

def write_status(rate=None, volume=-40.0, preset="AUREUS LINEAR 01", state="WAITING"):
    STATUS.write_text(f"state={state}\nrate={rate or 0}\nvolume={volume:.1f}\npreset={preset}\n")

def make_config(rate, cap, pb):
    text = f"""devices:
  samplerate: {rate}
  chunksize: 512
  queuelimit: 4
  silence_threshold: -100
  silence_timeout: 0
  target_level: 1024
  adjust_period: 5
  enable_rate_adjust: true
  capture_samplerate: {rate}
  stop_on_rate_change: true
  rate_measure_interval: 1.0
  volume_ramp_time: 300.0
  volume_limit: 0.0
  capture:
    type: Alsa
    channels: 2
    device: "hw:{cap}"
    format: S32_LE
  playback:
    type: Alsa
    channels: 2
    device: "hw:{pb}"
    format: S32_LE

mixers:
  stereo:
    channels:
      in: 2
      out: 2
    mapping:
      - dest: 0
        sources:
          - channel: 0
            gain: 1.0
      - dest: 1
        sources:
          - channel: 1
            gain: 1.0

filters: {{}}
pipeline:
  - type: Mixer
    name: stereo
"""
    CONF.write_text(text)

def main():
    cap = None
    pb = None
    proc = None
    while True:
        if cap is None:
            cap = find_capture()
        if pb is None:
            pb = find_playback()

        rate = active_rate(cap) if cap else None
        if not cap or not pb or not rate:
            write_status(rate, state="WAITING")
            time.sleep(1)
            continue

        if proc is None or proc.poll() is not None:
            make_config(rate, cap, pb)
            write_status(rate, state="RUNNING")
            with open(LOG, "a") as log:
                proc = subprocess.Popen(
                    ["/usr/local/bin/camilladsp", "--gain=-40.0", str(CONF)],
                    stdout=log, stderr=subprocess.STDOUT,
                    start_new_session=True
                )
            time.sleep(0.5)
        else:
            # CamillaDSP exits when stop_on_rate_change detects a change.
            if rate and str(rate) not in CONF.read_text(errors="ignore"):
                proc.terminate()
                proc.wait(timeout=2)
                proc = None
        time.sleep(1)

if __name__ == "__main__":
    main()
