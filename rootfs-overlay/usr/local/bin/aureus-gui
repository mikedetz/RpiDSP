#!/usr/bin/env python3

import re
import time
from pathlib import Path

import pygame


WIDTH = 1280
HEIGHT = 720


def detect_rate():

    for path in Path("/proc/asound").glob(
        "card*/pcm*c/sub*/hw_params"
    ):

        try:
            text = path.read_text()
        except Exception:
            continue

        match = re.search(
            r"rate:\s*(\d+)",
            text
        )

        if match:
            return int(match.group(1))

    return None


def format_rate(rate):

    if rate is None:
        return "---"

    if rate >= 1000:
        return f"{rate / 1000:.1f}"

    return str(rate)


pygame.init()

info = pygame.display.Info()

width = info.current_w or WIDTH
height = info.current_h or HEIGHT

screen = pygame.display.set_mode(
    (width, height),
    pygame.FULLSCREEN
)

pygame.mouse.set_visible(False)

font_title = pygame.font.Font(
    None,
    64
)

font_rate = pygame.font.Font(
    None,
    180
)

font_small = pygame.font.Font(
    None,
    52
)

font_preset = pygame.font.Font(
    None,
    38
)

clock = pygame.time.Clock()


def draw_center(text, font, y):

    surface = font.render(
        text,
        True,
        (235, 235, 235)
    )

    x = (
        width -
        surface.get_width()
    ) // 2

    screen.blit(
        surface,
        (x, y)
    )


while True:

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            raise SystemExit

    rate = detect_rate()

    screen.fill(
        (0, 0, 0)
    )

    draw_center(
        "AUREUS",
        font_title,
        40
    )

    if rate:

        draw_center(
            format_rate(rate),
            font_rate,
            150
        )

        draw_center(
            "kHz",
            font_small,
            340
        )

        draw_center(
            "LOCKED",
            font_small,
            410
        )

    else:

        draw_center(
            "WAITING FOR USB",
            font_small,
            300
        )

    draw_center(
        "-40.0 dB",
        font_small,
        500
    )

    draw_center(
        "AUREUS LINEAR 01",
        font_preset,
        610
    )

    pygame.display.flip()

    clock.tick(10)
