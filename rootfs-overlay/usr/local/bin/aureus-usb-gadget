#!/bin/sh
set -eu

G=/sys/kernel/config/usb_gadget/aureus
UDC_DIR=/sys/class/udc

RATES="44100,48000,88200,96000,176400,192000,352800,384000,705600,768000"
CHMASK=3
SSIZE=4

stop_gadget() {
    if [ -d "$G" ]; then
        if [ -e "$G/UDC" ]; then
            echo "" > "$G/UDC" || true
        fi
        rm -f "$G/configs/c.1/uac2.usb0" || true
        rmdir "$G/functions/uac2.usb0" 2>/dev/null || true
        rmdir "$G/configs/c.1/strings/0x409" 2>/dev/null || true
        rmdir "$G/configs/c.1" 2>/dev/null || true
        rmdir "$G/strings/0x409" 2>/dev/null || true
        rmdir "$G" 2>/dev/null || true
    fi
}

[ "${1:-}" = stop ] && { stop_gadget; exit 0; }

modprobe libcomposite
modprobe dwc2 || true

mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config

# Wait for the peripheral controller.
UDC=""
for _ in $(seq 1 30); do
    UDC="$(ls "$UDC_DIR" 2>/dev/null | head -n1 || true)"
    [ -n "$UDC" ] && break
    sleep 0.2
done
[ -n "$UDC" ] || { echo "No USB peripheral controller found. Check dtoverlay=dwc2,dr_mode=peripheral."; exit 1; }

stop_gadget || true

mkdir -p "$G"
cd "$G"

echo 0x1d6b > idVendor
echo 0x0104 > idProduct
echo 0x0200 > bcdUSB
echo 0x0100 > bcdDevice

mkdir -p strings/0x409
echo "AUREUS-0001" > strings/0x409/serialnumber
echo "AUREUS" > strings/0x409/manufacturer
echo "AUREUS DSP" > strings/0x409/product

mkdir -p configs/c.1/strings/0x409
echo "AUREUS DSP PCM" > configs/c.1/strings/0x409/configuration
echo 250 > configs/c.1/MaxPower

mkdir -p functions/uac2.usb0
echo "$CHMASK" > functions/uac2.usb0/c_chmask
echo "$RATES" > functions/uac2.usb0/c_srate
echo "$SSIZE" > functions/uac2.usb0/c_ssize
echo "$CHMASK" > functions/uac2.usb0/p_chmask
echo "$RATES" > functions/uac2.usb0/p_srate
echo "$SSIZE" > functions/uac2.usb0/p_ssize
echo adaptive > functions/uac2.usb0/c_sync

ln -s functions/uac2.usb0 configs/c.1/uac2.usb0

echo "$UDC" > UDC

logger -t aureus "UAC2 gadget attached to $UDC"
